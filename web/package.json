{
  "name": "coresample-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "coresample in the browser: click a region, find similar ones in a multiscale dataset, raw data only",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "model": "cd .. && uv run python web/scripts/export_model.py"
  },
  "dependencies": {
    "zarrita": "0.7.5",
    "onnxruntime-web": "1.30.0"
  },
  "devDependencies": {
    "vite": "7.1.12",
    "typescript": "5.9.3",
    "@webgpu/types": "0.1.74"
  }
}
